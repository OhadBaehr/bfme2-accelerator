// Cover art embedded in the loader, so the whole thing still ships as two files.
101 RCDATA "art\\tile_bfme2.jpg"
102 RCDATA "art\\tile_rotwk.jpg"
103 RCDATA "art\\tile_aotr.jpg"
// The mark, drawn in the window header beside the name.
104 RCDATA "art\\logo.png"
// The icon Explorer and the title bar use. Resource 1 so it is the one Windows picks.
1 ICON "art\\accel.ico"
// Common Controls 6 and the administrator level, in one manifest of our own.
1 24 "launcher.manifest"
// What Explorer shows under Properties > Details, and what a scanner reads first.
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,73
 PRODUCTVERSION 2,0,0,73
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BFME2 Accelerator (open source)"
            VALUE "FileDescription", "BFME2 Accelerator loader - starts the game with the accelerator"
            VALUE "FileVersion", "2.0.0.73"
            VALUE "InternalName", "bfme2_accel_loader"
            VALUE "LegalCopyright", "Copyright (c) 2026 OH1A. MIT licence."
            VALUE "OriginalFilename", "bfme2_accel_loader.exe"
            VALUE "ProductName", "BFME2 Accelerator"
            VALUE "ProductVersion", "2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
